[Unit]
Description=BOB ICU sanitized OpenClaw WhatsApp status snapshot
After=openclaw-gateway.service

[Service]
Type=oneshot
User=bar
Group=bar
RuntimeDirectory=bob-icu-openclaw-status
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
Environment=NODE_OPTIONS=--jitless
ExecStart=/usr/local/libexec/bob-icu/openclaw-whatsapp-status-snapshot /etc/bob-icu-openclaw/whatsapp-accounts.json /run/bob-icu-openclaw-status/whatsapp.json
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
UMask=0022
